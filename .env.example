# JWT 签名密钥：运行前替换为自己的随机密钥
JWT_SECRET=replace-with-your-own-jwt-secret-at-least-32-bytes

# Go 服务在 Compose 容器中运行时使用的 MySQL 配置
MYSQL_DSN=video_feed:video_feed_password@tcp(mysql:3306)/video_feed?charset=utf8mb4&parseTime=True&loc=Local

# Redis 连接地址
REDIS_ADDR=redis:6379

# RabbitMQ 连接地址
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/